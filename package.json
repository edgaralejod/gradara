{
  "name": "gradara-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "python3 scripts/start.py",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/project.test.ts tests/wiring.test.ts tests/selection.test.ts tests/nets.test.ts tests/names.test.ts tests/block-design.test.ts tests/results.test.ts tests/examples.test.ts tests/document-store.test.ts",
    "engine:test": ".venv/bin/python -m pytest -q",
    "local": "python3 scripts/start.py",
    "postinstall": "node scripts/patch-react-flow.mjs",
    "report:blocks": "tsx scripts/report-blocks.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "0.3.0",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.131.1"
  },
  "type": "module",
  "overrides": {
    "dompurify": "3.4.15"
  },
  "description": "Agent-assisted graphical multidomain simulation with OpenModelica",
  "license": "Apache-2.0",
  "author": {
    "name": "Edgar Duarte",
    "url": "https://virtu-services.us"
  },
  "repository": {
    "type": "git",
    "url": "https://origin.cursor.com/edgaralejod/gradara.git"
  },
  "homepage": "https://cursor.com/codebase/edgaralejod/gradara"
}
