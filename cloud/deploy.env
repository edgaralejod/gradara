# Non-secret settings for the Gradara AI gateway, read by cloud/deploy.sh.
# Secrets (vendor API key, Stripe keys, database URL, admin token) live only in
# Google Secret Manager; deploy.sh prompts for them and never writes them here.

GCP_PROJECT=gradara-2e47a
GCP_REGION=us-central1
PUBLIC_URL=https://api.gradara.app

# Firebase web app config for the sign-in page (public by design).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=gradara-2e47a.firebaseapp.com

# anthropic or openai, and the model the service calls.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Stripe mode is decided by the keys you store (sk_test_… or sk_live_…).
# Price ids must come from the same mode as the keys.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_AUTOMATIC_TAX=false

FREE_CREDITS=20
SUPPORT_EMAIL=support@virtu-services.us
