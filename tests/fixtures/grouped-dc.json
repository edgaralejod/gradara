      "blocks": [
        {
          "id": "controller",
          "definition": {
            "kind": "pi",
            "name": "PI controller",
            "description": "Sampled speed control with output saturation and a bounded integral state.",
            "domain": "signal",
            "symbol": "PI",
            "controller": true,
            "ports": [
              {
                "id": "reference",
                "name": "ref",
                "direction": "input",
                "domain": "signal"
              },
              {
                "id": "measured",
                "name": "meas",
                "direction": "input",
                "domain": "signal",
                "side": "bottom"
              },
              {
                "id": "y",
                "name": "out",
                "direction": "output",
                "domain": "signal"
              }
            ],
            "parameters": [
              {
                "id": "kp",
                "name": "Proportional gain",
                "value": 0.6,
                "unit": ""
              },
              {
                "id": "ki",
                "name": "Integral gain",
                "value": 2,
                "unit": ""
              },
              {
                "id": "limit",
                "name": "Voltage limit",
                "value": 24,
                "unit": "V",
                "min": 0.1
              },
              {
                "id": "samplePeriod",
                "name": "Sample period",
                "value": 0.001,
                "unit": "s",
                "min": 0.0001
              }
            ],
            "declarations": "discrete Real integral(start=0, fixed=true);\nReal error;",
            "equations": "error = reference - measured;\nwhen sample(0, samplePeriod) then\n  integral = max(-limit, min(limit, pre(integral) + samplePeriod*ki*error));\n  y = max(-limit, min(limit, kp*error + integral));\nend when;"
          },
          "position": {
            "x": 240,
            "y": 176
          },
          "size": {
