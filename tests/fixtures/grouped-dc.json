    {
      "id": "sub_grp000d",
      "name": "Drivetrain",
      "blocks": [
        {
          "id": "controller",
          "definition": {
            "kind": "pi",
            "name": "Speed controller (PI)",
            "symbol": "PI",
            "domain": "signal",
            "description": "Sampled PI with output saturation and a bounded integral state. Every state updates at the sample instant, so exported C reproduces it exactly.",
            "ports": [
              {
                "id": "reference",
                "name": "ref",
                "direction": "input",
                "domain": "signal",
                "side": "left"
              },
              {
                "id": "measured",
                "name": "meas",
                "direction": "input",
                "domain": "signal",
                "side": "bottom"
              },
              {
                "id": "y",
                "name": "y",
                "direction": "output",
                "domain": "signal",
                "side": "right",
                "unit": "V"
              }
            ],
            "equations": "error = reference - measured;\nwhen sample(0, samplePeriod) then\n  integral = max(-limit, min(limit, pre(integral) + samplePeriod*ki*error));\n  y = max(-limit, min(limit, kp*error + integral));\nend when;",
            "parameters": [
              {
                "id": "kp",
                "name": "Proportional gain",
                "value": 0.6,
                "unit": ""
