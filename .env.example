# Gradara reads these from the launching shell; copying this file to .env does
# not load them. All are optional.
#
# Simulation engine: auto (default), native, or docker.
# GRADARA_ENGINE=auto
# Path to omc when OpenModelica is not on PATH or in a standard location.
# GRADARA_OMC=/opt/openmodelica/bin/omc
# Alternate Docker context (for example a dedicated Colima profile).
# GRADARA_DOCKER_CONTEXT=colima-gradara
#
# AI provider: gradara, openai, anthropic, codex, or off (overrides Settings).
# GRADARA_AI_PROVIDER=codex
# Codex executable when it is not on PATH.
# GRADARA_CODEX_BIN=/path/to/codex
# Gradara AI service, for a local gateway during development.
# GRADARA_GATEWAY_URL=http://127.0.0.1:8900
# Keep API keys and the Gradara AI sign-in in a private file (mode 0600) in the
# data folder instead of the OS keychain.
# GRADARA_CREDENTIAL_STORE=file
# Keep a local copy of AI prompts and responses in the data folder (agent/) for debugging.
# GRADARA_KEEP_AI_TRANSCRIPTS=1
#
# Data folder (the desktop app sets this to the OS application-data folder).
# GRADARA_DATA_DIR=/path/to/data
#
# Older Flux names still work if already set:
# FLUX_DOCKER_CONTEXT=colima-flux
# FLUX_CODEX_BIN=/path/to/codex
