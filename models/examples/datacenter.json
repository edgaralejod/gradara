    {
      "id": "cooling",
      "definition": {
        "kind": "dataCenterCooling",
        "name": "Cooling plant",
        "domain": "thermal",
        "symbol": "COP",
        "generated": true,
        "description": "Aggregate sensible cooling with fixed COP, 20 s response, and a temporary 50% capacity limit from 1800 to 2100 s. Electrical compressor power and condenser heat are conserved. No pumps, fans, fluid circuit, humidity, or weather-dependent performance.",
        "ports": [
          {
            "id": "p",
            "name": "p",
            "domain": "electrical",
            "side": "top",
            "direction": "physical"
          },
          {
            "id": "n",
            "name": "n",
            "domain": "electrical",
            "side": "top",
            "direction": "physical"
          },
          {
            "id": "cold",
            "name": "cold",
            "domain": "thermal",
            "side": "left",
            "direction": "physical"
          },
          {
            "id": "hot",
            "name": "hot",
            "domain": "thermal",
            "side": "right",
            "direction": "physical"
          },
          {
            "id": "u",
            "name": "u",
            "side": "bottom",
            "domain": "signal",
            "direction": "input"
          },
          {
            "id": "kW",
            "name": "kW",
            "unit": "kW",
            "side": "bottom",
            "domain": "signal",
            "direction": "output"
          },
          {
            "id": "coolkW",
            "name": "Q",
            "unit": "kW",
            "side": "bottom",
            "domain": "signal",
            "direction": "output"
          }
        ],
        "parameters": [
          {
            "id": "ratedCooling",
            "name": "ratedCooling",
            "value": 1200000,
            "unit": "W"
          },
          {
            "id": "COP",
            "name": "COP",
            "value": 4,
            "unit": ""
          },
          {
            "id": "responseTime",
            "name": "responseTime",
            "value": 20,
            "unit": "s"
          },
          {
            "id": "initialCooling",
            "name": "initialCooling",
            "value": 600000,
            "unit": "W"
          },
          {
            "id": "derateStart",
            "name": "derateStart",
            "value": 1800,
            "unit": "s"
          },
          {
            "id": "derateEnd",
            "name": "derateEnd",
            "value": 2100,
            "unit": "s"
          },
          {
            "id": "availableFraction",
            "name": "availableFraction",
            "value": 0.5,
            "unit": ""
          },
          {
            "id": "minimumVoltage",
            "name": "minimumVoltage",
            "value": 400,
            "unit": "V"
          }
        ],
        "declarations": "Real cooling(start=initialCooling, fixed=true); Real available; Real voltage; Real power; Real removedEnergy(start=0, fixed=true);",
        "equations": "voltage = p.v-n.v;\navailable = if time >= derateStart and time < derateEnd then availableFraction else 1;\nresponseTime*der(cooling) = ratedCooling*min(max(u, 0), available)*min(voltage*voltage/(minimumVoltage*minimumVoltage), 1)-cooling;\np.i = (cooling/COP)*voltage/max(voltage*voltage, minimumVoltage*minimumVoltage);\np.i+n.i = 0;\npower = voltage*p.i;\ncold.Q_flow = cooling;\nhot.Q_flow = -cooling-power;\nkW = power/1000;\ncoolkW = cooling/1000;\nder(removedEnergy) = cooling;"
      },
      "position": {
        "x": 1000,
        "y": 192
      },
      "size": {
        "width": 128,
        "height": 96
      },
      "labelOffset": {
        "x": 80,
        "y": 0
      }
    },
    {
      "id": "ambient",
      "definition": {
        "kind": "dataCenterAmbient",
        "name": "Outdoor heat sink",
        "domain": "thermal",
        "symbol": "T",
        "generated": true,
        "description": "Infinite fixed-temperature heat sink. COP is fixed independently of this temperature; changing ambient temperature does not predict weather sensitivity.",
        "ports": [
