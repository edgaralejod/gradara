{
  "version": 1,
  "name": "Servo position control",
  "exampleId": "servo",
  "description": "DC motor position servo: a 1 rad step at 0.2 s, a sampled PID at 1 kHz with a clamped integral and a ±24 V output limit, a controlled voltage source, the same permanent-magnet DC machine as the speed loop, and a measured shaft angle. The controller is built for C export; its exported step function reproduces the sampled equations exactly.",
  "duration": 2,
  "revision": 0,
  "blocks": [
    {
      "id": "reference",
      "definition": {
        "kind": "step",
        "name": "Position request",
        "description": "A step change from zero to a final value.",
        "domain": "signal",
        "category": "sources",
        "symbol": "step",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "rad"
          }
        ],
        "parameters": [
          {
            "id": "height",
            "name": "Target angle",
            "value": 1,
            "unit": "rad"
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0.2,
            "unit": "s",
            "min": 0
          }
        ],
        "equations": "// Blocks.Sources.Step from the Modelica Standard Library 4.1.0",
        "keywords": [
          "source",
          "reference"
        ],
        "modelica": {
          "class": "Modelica.Blocks.Sources.Step",
          "modifiers": {
            "height": "height",
            "startTime": "startTime"
          }
        }
      },
      "position": {
        "x": 32,
        "y": 184
      },
      "size": {
        "width": 80,
        "height": 64
      },
      "logged": [
        "y"
      ]
    },
    {
      "id": "controller",
      "definition": {
        "kind": "discretePID",
        "name": "Position controller (PID)",
        "symbol": "PID(z)",
        "domain": "signal",
        "description": "Sampled PID with a filtered derivative, a clamped integral, and output saturation. Every state updates at the sample instant, so exported C reproduces it exactly.",
        "ports": [
          {
            "id": "reference",
            "name": "ref",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "measured",
            "name": "meas",
            "direction": "input",
            "domain": "signal",
            "side": "bottom"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          }
        ],
        "equations": "when sample(0, samplePeriod) then\n  e = reference - measured;\n  integral = max(-limit, min(limit, pre(integral) + samplePeriod*ki*e));\n  derivative = (filterTime*pre(derivative) + kd*(e - pre(errorPrev)))/(filterTime + samplePeriod);\n  errorPrev = e;\n  y = max(-limit, min(limit, kp*e + integral + derivative));\nend when;",
        "parameters": [
          {
            "id": "kp",
            "name": "Proportional gain",
            "value": 30,
            "unit": ""
          },
          {
            "id": "ki",
            "name": "Integral gain",
            "value": 1,
            "unit": ""
          },
          {
            "id": "kd",
            "name": "Derivative gain",
            "value": 3,
            "unit": ""
          },
          {
            "id": "filterTime",
            "name": "Derivative filter",
            "value": 0.01,
            "unit": "s",
            "min": 0.0001
          },
          {
            "id": "limit",
            "name": "Output limit",
            "value": 24,
            "unit": "",
            "min": 0.001
          },
          {
            "id": "samplePeriod",
            "name": "Sample period",
            "value": 0.001,
            "unit": "s",
            "min": 0.0001
          }
        ],
        "declarations": "discrete Real e(start=0, fixed=true);\ndiscrete Real integral(start=0, fixed=true);\ndiscrete Real derivative(start=0, fixed=true);\ndiscrete Real errorPrev(start=0, fixed=true);",
        "keywords": [
          "control",
          "regulator",
          "discrete",
          "sampled",
          "export",
          "c"
        ],
        "controller": true
      },
      "position": {
        "x": 184,
        "y": 168
      },
      "size": {
        "width": 128,
        "height": 96
      },
      "labelOffset": {
