{
  "version": 1,
  "name": "Motor speed control",
  "blocks": [
    {
      "id": "reference",
      "definition": {
        "kind": "step",
        "name": "Speed reference",
        "description": "A step change in the requested motor speed.",
        "domain": "signal",
        "symbol": "step",
        "ports": [
          {
            "id": "y",
            "name": "out",
            "direction": "output",
            "domain": "signal"
          }
        ],
        "parameters": [
          {
            "id": "height",
            "name": "Target speed",
            "value": 100,
            "unit": "rad/s"
          },
          {
            "id": "startTime",
            "name": "Step time",
            "value": 0.2,
            "unit": "s",
            "min": 0
          }
        ],
        "equations": "y = if time < startTime then 0 else height;"
      },
      "position": {
        "x": 40,
        "y": 192
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "controller",
      "definition": {
        "kind": "pi",
        "name": "PI controller",
        "description": "Sampled speed control with output saturation and a bounded integral state.",
        "domain": "signal",
        "symbol": "PI",
        "controller": true,
        "ports": [
          {
            "id": "reference",
            "name": "ref",
            "direction": "input",
            "domain": "signal"
          },
          {
            "id": "measured",
            "name": "meas",
            "direction": "input",
            "domain": "signal",
            "side": "bottom"
          },
          {
            "id": "y",
            "name": "out",
            "direction": "output",
            "domain": "signal"
          }
        ],
        "parameters": [
          {
            "id": "kp",
            "name": "Proportional gain",
            "value": 0.6,
            "unit": ""
          },
          {
            "id": "ki",
            "name": "Integral gain",
            "value": 2,
            "unit": ""
          },
          {
            "id": "limit",
            "name": "Voltage limit",
            "value": 24,
            "unit": "V",
            "min": 0.1
          },
          {
            "id": "samplePeriod",
            "name": "Sample period",
            "value": 0.001,
            "unit": "s",
            "min": 0.0001
          }
        ],
        "declarations": "discrete Real integral(start=0, fixed=true);\nReal error;",
        "equations": "error = reference - measured;\nwhen sample(0, samplePeriod) then\n  integral = max(-limit, min(limit, pre(integral) + samplePeriod*ki*error));\n  y = max(-limit, min(limit, kp*error + integral));\nend when;"
      },
      "position": {
        "x": 240,
        "y": 176
      },
      "size": {
        "width": 128,
        "height": 96
      },
      "labelOffset": {
        "x": 0,
        "y": -132
      }
    },
    {
      "id": "drive",
      "definition": {
        "kind": "voltage",
        "name": "Voltage drive",
        "description": "An ideal voltage source driven by a control signal.",
        "domain": "electrical",
        "symbol": "V",
        "ports": [
          {
            "id": "u",
            "name": "in",
            "direction": "input",
            "domain": "signal"
          },
          {
            "id": "p",
            "name": "+",
            "domain": "electrical",
            "side": "right",
            "direction": "physical"
          },
          {
            "id": "n",
            "name": "−",
            "domain": "electrical",
            "side": "bottom",
            "direction": "physical"
          }
        ],
        "parameters": [],
        "equations": "v = u;"
      },
      "position": {
        "x": 472,
        "y": 176
      },
      "size": {
        "width": 128,
        "height": 96
      },
      "labelOffset": {
        "x": 0,
        "y": -132
      }
    },
    {
      "id": "motor",
      "definition": {
        "kind": "motor",
        "name": "DC motor",
        "description": "Armature resistance and inductance coupled to a rotational shaft.",
        "domain": "electrical",
        "symbol": "M",
        "ports": [
          {
            "id": "p",
            "name": "+",
            "domain": "electrical",
            "side": "left",
            "direction": "physical"
          },
          {
            "id": "n",
            "name": "−",
            "domain": "electrical",
            "side": "bottom",
            "direction": "physical",
            "offset": 25
          },
          {
            "id": "flange",
            "name": "shaft",
            "domain": "mechanical",
            "side": "bottom",
            "direction": "physical",
            "offset": 75
          }
        ],
        "parameters": [
          {
            "id": "R",
            "name": "Resistance",
            "value": 1.2,
            "unit": "Ω",
            "min": 0.001
          },
          {
            "id": "L",
            "name": "Inductance",
            "value": 0.02,
            "unit": "H",
            "min": 0.00001
          },
          {
            "id": "k",
            "name": "Motor constant",
            "value": 0.15,
            "unit": "N·m/A",
            "min": 0.0001
          }
        ],
        "equations": "L*der(i) = v - R*i - k*w;\ntau = k*i;"
      },
      "position": {
        "x": 704,
        "y": 176
      },
      "size": {
        "width": 128,
        "height": 96
      },
      "labelOffset": {
        "x": 0,
        "y": -132
      }
    },
    {
      "id": "load",
      "definition": {
        "kind": "inertia",
        "name": "Inertia & load",
        "description": "A rotating load with inertia and viscous friction.",
        "domain": "mechanical",
        "symbol": "J",
        "ports": [
          {
            "id": "a",
            "name": "shaft",
            "domain": "mechanical",
            "side": "top",
            "direction": "physical"
          },
          {
            "id": "b",
            "name": "shaft",
            "domain": "mechanical",
            "side": "left",
            "direction": "physical"
          }
        ],
        "parameters": [
          {
            "id": "J",
            "name": "Inertia",
            "value": 0.02,
            "unit": "kg·m²",
            "min": 0.00001
          },
          {
            "id": "damping",
            "name": "Viscous friction",
            "value": 0.002,
            "unit": "N·m·s",
            "min": 0
          }
        ],
        "equations": "J*der(w) = tau - damping*w;"
      },
      "position": {
        "x": 736,
        "y": 416
      },
      "size": {
        "width": 128,
        "height": 96
      }
    },
    {
      "id": "sensor",
      "definition": {
        "kind": "sensor",
        "name": "Speed sensor",
        "description": "Measures shaft speed without loading the mechanical system.",
        "domain": "mechanical",
        "symbol": "ω",
        "ports": [
          {
            "id": "flange",
            "name": "shaft",
            "domain": "mechanical",
            "side": "right",
