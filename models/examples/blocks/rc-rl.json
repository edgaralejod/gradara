{
  "version": 1,
  "name": "Example: RC and RL transients",
  "exampleId": "block-rc-rl",
  "description": "Two 10 V steps start at 0 s. The RC branch (1 kΩ, 100 µF) has a time constant of 0.1 s: the capacitor reaches 63 % of 10 V at 0.1 s and is essentially full after 0.5 s. The RL branch (a 0.1 S conductor, which is 10 Ω, and a 1 H inductor) has the same time constant, so its current rises to 63 % of 1 A at 0.1 s.",
  "duration": 0.5,
  "revision": 0,
