{
  "version": 1,
  "name": "Example: Signal sources",
  "exampleId": "block-signal-sources",
  "description": "Each source drives nothing, so its output is exactly the waveform it makes. Compare the step at 0.5 s, the ramp that starts at 0.5 s, the 2 Hz sine, the 1 Hz pulse at 25 % duty, and the clock, which is simulation time itself. A constant is a fixed parameter, so it has no trace of its own; see it at work in Arithmetic.",
  "duration": 2,
  "revision": 0,
  "blocks": [
    {
      "id": "const",
      "definition": {
        "kind": "constant",
        "name": "Constant",
        "symbol": "constant",
        "domain": "signal",
        "description": "Constant",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = value;",
        "parameters": [
          {
            "id": "value",
            "name": "Value",
            "value": 3,
            "unit": ""
          }
        ],
        "declarations": ""
      },
      "position": {
        "x": 40,
        "y": 64
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "step",
      "definition": {
        "kind": "step",
        "name": "Step",
        "description": "A step change from zero to a final value.",
        "domain": "signal",
        "symbol": "step",
        "ports": [
          {
            "id": "y",
            "name": "out",
            "direction": "output",
            "domain": "signal"
          }
        ],
        "parameters": [
          {
            "id": "height",
            "name": "Height",
            "value": 2,
            "unit": ""
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0.5,
            "unit": "s",
            "min": 0
          }
        ],
        "equations": "y = if time < startTime then 0 else height;",
        "keywords": [
          "source",
          "reference"
        ]
      },
      "position": {
        "x": 216,
        "y": 64
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "ramp",
      "definition": {
        "kind": "ramp",
        "name": "Ramp",
        "symbol": "ramp",
        "domain": "signal",
        "description": "A linearly increasing signal after a start time.",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = if time < startTime then 0 else slope*(time-startTime);",
        "parameters": [
          {
            "id": "slope",
            "name": "Slope",
            "value": 1.5,
            "unit": "1/s"
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0.5,
            "unit": "s",
            "min": 0
          }
        ],
        "declarations": "",
        "keywords": [
          "source",
          "reference"
        ]
      },
      "position": {
        "x": 392,
        "y": 64
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "sine",
      "definition": {
        "kind": "sine",
        "name": "Sine",
        "symbol": "sine",
        "domain": "signal",
        "description": "A continuous sinusoid.",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = offset + amplitude*sin(6.283185307179586*frequency*time + phase);",
        "parameters": [
          {
            "id": "amplitude",
            "name": "Amplitude",
            "value": 1,
            "unit": ""
          },
          {
            "id": "frequency",
            "name": "Frequency",
            "value": 2,
            "unit": "Hz",
            "min": 0
          },
          {
            "id": "phase",
            "name": "Phase",
            "value": 0,
            "unit": "rad"
          },
          {
            "id": "offset",
            "name": "Offset",
            "value": 0,
            "unit": ""
          }
        ],
        "declarations": "",
        "keywords": [
          "source",
          "oscillator",
          "wave"
        ]
      },
      "position": {
        "x": 40,
        "y": 176
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "pulse",
      "definition": {
        "kind": "pulse",
        "name": "Pulse",
        "symbol": "pulse",
        "domain": "signal",
        "description": "A periodic rectangular pulse.",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = if mod(time - startTime + period, period) < width*period then amplitude else 0;",
        "parameters": [
          {
            "id": "amplitude",
            "name": "Amplitude",
            "value": 1,
            "unit": ""
          },
          {
            "id": "period",
            "name": "Period",
            "value": 1,
            "unit": "s",
            "min": 0.0001
          },
          {
            "id": "width",
            "name": "Duty cycle",
            "value": 0.25,
            "unit": "",
            "min": 0
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0,
            "unit": "s",
            "min": 0
          }
        ],
        "declarations": "",
        "keywords": [
          "source",
          "square",
          "pwm"
        ]
      },
      "position": {
        "x": 216,
        "y": 176
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "clock",
      "definition": {
        "kind": "clock",
        "name": "Clock",
        "symbol": "clock",
        "domain": "signal",
        "description": "Simulation time as a signal.",
        "ports": [
          {
            "id": "y",
            "name": "t",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "s"
          }
        ],
        "equations": "y = time;",
        "parameters": [],
        "declarations": "",
        "keywords": [
          "source",
          "time"
        ]
      },
      "position": {
        "x": 392,
        "y": 176
      },
      "size": {
        "width": 80,
        "height": 64
      }
    }
