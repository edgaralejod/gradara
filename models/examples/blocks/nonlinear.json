{
  "version": 1,
  "name": "Example: Nonlinearities",
  "exampleId": "block-nonlinear",
  "description": "The input is a 1 Hz sine of amplitude 2. Saturation clips it to ±1. The dead zone removes the band ±0.5, so the peak of 2 comes out as 1.5. The relay outputs +1 whenever the input is at or above 0 and −1 otherwise. The rate limiter lets the output change by at most 2 per second, so it cannot keep up: it reaches only 0.5 by the first peak.",
  "duration": 2,
  "revision": 0,
  "blocks": [
    {
      "id": "sine",
      "definition": {
        "kind": "sine",
        "name": "Sine, amplitude 2",
        "description": "A continuous sinusoid.",
        "domain": "signal",
        "category": "sources",
        "symbol": "sine",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right"
          }
        ],
        "parameters": [
          {
            "id": "amplitude",
            "name": "Amplitude",
            "value": 2,
            "unit": ""
          },
          {
            "id": "frequency",
            "name": "Frequency",
            "value": 1,
            "unit": "Hz",
            "min": 0
          },
          {
            "id": "phase",
            "name": "Phase",
            "value": 0,
            "unit": "rad"
          },
          {
            "id": "offset",
            "name": "Offset",
            "value": 0,
            "unit": ""
          }
        ],
        "equations": "// Blocks.Sources.Sine from the Modelica Standard Library 4.1.0",
        "keywords": [
          "source",
          "oscillator",
          "wave"
        ],
        "modelica": {
          "class": "Modelica.Blocks.Sources.Sine",
          "modifiers": {
            "amplitude": "amplitude",
            "f": "frequency",
            "phase": "phase",
            "offset": "offset"
          }
        }
      },
      "position": {
        "x": 40,
        "y": 232
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "sat",
      "definition": {
        "kind": "saturation",
        "name": "Saturation ±1",
        "description": "Clamp a signal between lower and upper limits.",
        "domain": "signal",
        "category": "nonlinear",
        "symbol": "sat",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right"
          }
        ],
        "parameters": [
          {
            "id": "lower",
            "name": "Lower limit",
            "value": -1,
            "unit": ""
          },
          {
            "id": "upper",
            "name": "Upper limit",
            "value": 1,
            "unit": ""
          }
        ],
        "equations": "// Blocks.Nonlinear.Limiter from the Modelica Standard Library 4.1.0",
        "keywords": [
          "nonlinear",
          "limit",
          "clamp"
        ],
        "modelica": {
          "class": "Modelica.Blocks.Nonlinear.Limiter",
          "modifiers": {
            "uMin": "lower",
            "uMax": "upper"
          }
        }
      },
      "position": {
        "x": 392,
        "y": 64
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "dz",
      "definition": {
        "kind": "deadzone",
        "name": "Dead zone ±0.5",
        "description": "Zero output inside ±half-width.",
        "domain": "signal",
        "category": "nonlinear",
        "symbol": "dead",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right"
          }
        ],
        "parameters": [
          {
            "id": "start",
            "name": "Half-width",
            "value": 0.5,
            "unit": "",
            "min": 0
          }
        ],
        "equations": "// Blocks.Nonlinear.DeadZone from the Modelica Standard Library 4.1.0",
        "keywords": [
          "nonlinear"
        ],
        "modelica": {
          "class": "Modelica.Blocks.Nonlinear.DeadZone",
          "modifiers": {
