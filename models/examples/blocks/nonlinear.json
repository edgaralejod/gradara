          "hysteresis"
        ]
      },
      "position": {
        "x": 392,
        "y": 288
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "rate",
      "definition": {
        "kind": "rateLimiter",
        "name": "Rate limit 2/s",
        "description": "Limits how fast a signal may change.",
        "domain": "signal",
        "category": "nonlinear",
        "symbol": "du/dt",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
