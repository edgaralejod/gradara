        "width": 80,
        "height": 64
      }
    },
    {
      "id": "relay",
      "definition": {
        "kind": "relay",
        "name": "Relay",
        "symbol": "relay",
        "domain": "signal",
        "description": "A two-level relay.",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = if u >= offSwitch then onValue else offValue;",
        "parameters": [
          {
            "id": "onValue",
            "name": "On value",
            "value": 1,
            "unit": ""
          },
          {
            "id": "offValue",
            "name": "Off value",
            "value": -1,
            "unit": ""
          },
          {
            "id": "offSwitch",
            "name": "Switch level",
            "value": 0,
            "unit": ""
          }
        ],
        "declarations": "",
        "keywords": [
