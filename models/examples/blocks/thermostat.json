            "id": "reference",
            "name": "ref",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "u",
            "name": "meas",
            "direction": "input",
            "domain": "signal",
            "side": "bottom"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "boolean",
            "side": "right"
          }
        ],
        "parameters": [
          {
            "id": "bandwidth",
            "name": "Bandwidth",
            "value": 2,
            "unit": "",
            "min": 0
          }
        ],
        "equations": "// Blocks.Logical.OnOffController from the Modelica Standard Library 4.1.0",
        "keywords": [
          "thermostat",
          "bang-bang"
        ],
        "modelica": {
          "class": "Modelica.Blocks.Logical.OnOffController",
          "modifiers": {
            "pre_y_start": "false",
            "bandwidth": "bandwidth"
          }
        }
