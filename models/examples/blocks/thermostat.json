        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = value;",
        "parameters": [
          {
            "id": "value",
            "name": "Value",
            "value": 323.15,
            "unit": ""
          }
        ],
        "declarations": ""
      },
      "position": {
        "x": 40,
        "y": 128
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
