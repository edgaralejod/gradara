{
  "version": 1,
  "name": "Example: End stops and motion sources",
  "exampleId": "block-end-stops",
  "description": "The mass with stops is shaken by ±20 N; it sticks until the force overcomes its friction, then slides and stays against the +0.5 m stop while the force pushes it there. The elastic stop starts level with its mass, and its gap of −5 cm gives 5 cm of free travel: the mass pushed by 10 N crosses it and comes to rest pressing 10 µm into the stop. The speed source moves its mass at 0.2 m/s, and the position source makes its mass follow a 0.1 m sine.",
  "duration": 2,
  "revision": 0,
  "blocks": [
    {
      "id": "fsig",
      "definition": {
        "kind": "sine",
        "name": "20 sin(πt) N",
        "symbol": "sine",
        "domain": "signal",
        "description": "A continuous sinusoid.",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = offset + amplitude*sin(6.283185307179586*frequency*time + phase);",
        "parameters": [
          {
            "id": "amplitude",
            "name": "Amplitude",
            "value": 20,
            "unit": ""
          },
          {
            "id": "frequency",
            "name": "Frequency",
            "value": 0.5,
            "unit": "Hz",
            "min": 0
          },
          {
            "id": "phase",
            "name": "Phase",
            "value": 0,
            "unit": "rad"
          },
