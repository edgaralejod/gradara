            "value": 1,
            "unit": ""
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0.1,
            "unit": "s",
            "min": 0
          }
        ],
        "equations": "// Blocks.Sources.Step from the Modelica Standard Library 4.1.0",
        "keywords": [
          "source",
          "reference"
        ],
        "modelica": {
          "class": "Modelica.Blocks.Sources.Step",
