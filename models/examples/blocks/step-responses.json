{
  "version": 1,
  "name": "Example: Step responses",
  "exampleId": "block-step-responses",
  "description": "The step comes at 0.1 s. The filter (τ = 0.2 s) reaches 63 % at 0.3 s. The second-order block (ωn = 10 rad/s, ζ = 0.3) overshoots to 1.37 at 0.43 s and rings down. The integrator rises at 1 per second. The delay repeats the step 0.3 s late. The derivative of a ramp with slope 2 is 2.",
  "duration": 2,
  "revision": 0,
  "blocks": [
    {
      "id": "step",
      "definition": {
        "kind": "step",
        "name": "Step at 0.1 s",
        "description": "A step change from zero to a final value.",
        "domain": "signal",
        "symbol": "step",
        "ports": [
          {
            "id": "y",
            "name": "out",
            "direction": "output",
            "domain": "signal"
          }
        ],
        "parameters": [
          {
            "id": "height",
            "name": "Height",
            "value": 1,
            "unit": ""
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0.1,
            "unit": "s",
            "min": 0
          }
        ],
        "equations": "y = if time < startTime then 0 else height;",
        "keywords": [
          "source",
          "reference"
        ]
      },
      "position": {
        "x": 40,
        "y": 232
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "filter",
      "definition": {
        "kind": "filter",
        "name": "First order",
        "description": "First-order continuous filter.",
        "domain": "signal",
        "symbol": "1/(τs+1)",
        "ports": [
          {
            "id": "u",
            "name": "in",
            "direction": "input",
            "domain": "signal"
          },
          {
            "id": "y",
            "name": "out",
            "direction": "output",
            "domain": "signal"
          }
        ],
        "parameters": [
          {
            "id": "tau",
            "name": "Time constant",
            "value": 0.2,
            "unit": "s",
            "min": 0.00001
          }
        ],
        "declarations": "Real x(start=0, fixed=true);",
        "equations": "der(x) = (u-x)/tau;\ny = x;"
      },
      "position": {
        "x": 392,
        "y": 64
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "second",
      "definition": {
        "kind": "secondOrder",
        "name": "Second order",
        "symbol": "ωn,ζ",
        "domain": "signal",
        "description": "A second-order transfer function ωn² / (s² + 2ζωn s + ωn²).",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "der(x1) = x2;\nder(x2) = wn*wn*(u - x1) - 2*zeta*wn*x2;\ny = x1;",
        "parameters": [
          {
            "id": "wn",
            "name": "Natural frequency",
            "value": 10,
            "unit": "rad/s",
            "min": 0.01
          },
          {
            "id": "zeta",
            "name": "Damping ratio",
            "value": 0.3,
            "unit": "",
            "min": 0
          }
        ],
        "declarations": "Real x1(start=0, fixed=true);\nReal x2(start=0, fixed=true);",
        "keywords": [
          "continuous",
          "tf",
          "transfer"
        ]
      },
      "position": {
        "x": 392,
        "y": 176
      },
      "size": {
        "width": 160,
        "height": 64
      }
    },
    {
      "id": "int",
      "definition": {
        "kind": "integrator",
        "name": "Integrator",
        "symbol": "1/s",
        "domain": "signal",
        "description": "Limited integrator",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "der(x) = if (x >= limit and u > 0) or (x <= -limit and u < 0) then 0 else u;\ny = x;",
        "parameters": [
          {
            "id": "limit",
            "name": "Integral limit",
            "value": 100,
            "unit": "",
            "min": 0.01
          }
        ],
        "declarations": "Real x(start=0, fixed=true);"
      },
      "position": {
        "x": 392,
        "y": 288
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "delay",
      "definition": {
        "kind": "delay",
        "name": "Delay 0.3 s",
        "symbol": "e⁻sT",
        "domain": "signal",
        "description": "A pure time delay.",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = delay(u, T);",
        "parameters": [
          {
            "id": "T",
            "name": "Delay",
            "value": 0.3,
            "unit": "s",
            "min": 0
          }
        ],
        "declarations": "",
        "keywords": [
          "continuous",
          "delay"
        ]
      },
      "position": {
        "x": 392,
        "y": 400
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "ramp",
      "definition": {
        "kind": "ramp",
        "name": "Ramp, slope 2",
        "symbol": "ramp",
        "domain": "signal",
        "description": "A linearly increasing signal after a start time.",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = if time < startTime then 0 else slope*(time-startTime);",
        "parameters": [
          {
            "id": "slope",
            "name": "Slope",
            "value": 2,
            "unit": "1/s"
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0,
            "unit": "s",
            "min": 0
          }
        ],
        "declarations": "",
        "keywords": [
          "source",
          "reference"
        ]
      },
      "position": {
        "x": 40,
        "y": 568
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "deriv",
      "definition": {
        "kind": "derivative",
        "name": "Derivative",
        "symbol": "s",
        "domain": "signal",
        "description": "Filtered derivative du/dt.",
        "ports": [
          {
            "id": "u",
            "name": "u",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "der(x) = (u - x)/tau;\ny = (u - x)/tau;",
        "parameters": [
          {
            "id": "tau",
            "name": "Filter time",
            "value": 0.01,
            "unit": "s",
            "min": 0.00001
          }
        ],
        "declarations": "Real x(start=0, fixed=true);",
        "keywords": [
          "continuous",
          "diff"
        ]
      },
      "position": {
        "x": 392,
        "y": 568
      },
      "size": {
        "width": 80,
        "height": 64
      }
    }
