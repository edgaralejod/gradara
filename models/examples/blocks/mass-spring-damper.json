{
  "version": 1,
  "name": "Example: Mass, spring, and damper",
  "exampleId": "block-mass-spring-damper",
  "description": "Both systems have a natural frequency of 10 rad/s and a damping ratio of 0.1, so they ring and settle at 1 N / 100 N/m = 1 cm. The upper one uses a combined spring-damper and is pushed by a force step at 0.1 s through a force sensor. The lower one has a separate spring and damper and a force that acts from the start, so it overshoots to 1.73 cm at 0.32 s.",
  "duration": 8,
  "revision": 0,
