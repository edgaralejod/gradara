      "definition": {
        "kind": "idealSwitch",
        "name": "Ideal switch",
        "domain": "electrical",
        "category": "electrical",
        "symbol": "switch",
        "description": "Ideal bidirectional power switch. Gate above 0.5 closes the switch; zero on-resistance and zero off-conductance.",
        "ports": [
          {
            "id": "p",
            "name": "+",
            "domain": "electrical",
            "direction": "physical",
            "side": "top"
