            "direction": "input",
            "side": "left",
            "domain": "signal",
            "unit": ""
          }
        ],
        "parameters": [],
        "equations": "p.i + n.i = 0;\nif gate > 0.5 then\n  p.v = n.v;\nelse\n  p.i = 0;\nend if;",
