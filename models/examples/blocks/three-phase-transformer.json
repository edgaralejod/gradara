{
  "version": 1,
  "name": "Example: Three-phase transformer",
  "exampleId": "block-three-phase-transformer",
  "description": "The ratio 2 halves the line-to-line voltage, so the 100 V peak phase voltage on the delta side becomes about 50 V on the star side, 30° later (vector group Dy1). The load draws about 1 A per phase; the winding resistance and leakage take a little of the voltage. The three-phase voltage sensor reads each output phase against the load star point, which is grounded with the transformer neutral.",
  "duration": 0.1,
  "revision": 0,
  "blocks": [
    {
      "id": "s",
      "definition": {
        "kind": "threePhaseSource",
        "name": "100 V 50 Hz",
        "description": "Balanced three-phase sinusoidal voltages from plug − to plug +; a Star point on plug − gives the neutral.",
        "domain": "threePhase",
        "category": "threePhase",
        "symbol": "3~ AC",
        "ports": [
          {
            "id": "plug_p",
            "name": "abc",
            "direction": "physical",
            "domain": "threePhase",
            "side": "right"
          },
          {
            "id": "plug_n",
            "name": "abc−",
            "direction": "physical",
            "domain": "threePhase",
            "side": "bottom"
          }
        ],
        "parameters": [
          {
            "id": "V",
            "name": "Phase amplitude",
            "value": 100,
            "unit": "V"
          },
          {
            "id": "f",
            "name": "Frequency",
            "value": 50,
            "unit": "Hz",
            "min": 0
          }
        ],
        "equations": "// Electrical.Polyphase.Sources.SineVoltage from the Modelica Standard Library 4.1.0",
        "keywords": [
          "grid",
          "mains",
          "three phase"
        ],
        "modelica": {
          "class": "Modelica.Electrical.Polyphase.Sources.SineVoltage",
          "modifiers": {
            "V": "fill(V, 3)",
            "f": "fill(f, 3)"
          }
        }
      },
      "position": {
        "x": 104,
        "y": 128
      },
