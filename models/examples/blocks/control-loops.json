        "name": "Plant (PI)",
        "description": "First-order continuous filter.",
        "domain": "signal",
        "symbol": "1/(τs+1)",
        "ports": [
          {
            "id": "u",
            "name": "in",
            "direction": "input",
            "domain": "signal"
          },
          {
            "id": "y",
