    {
      "id": "c3",
      "definition": {
        "kind": "pi",
        "name": "PI (sampled)",
        "symbol": "PI",
        "domain": "signal",
        "description": "Sampled PI with output saturation and a bounded integral state. Every state updates at the sample instant, so exported C reproduces it exactly.",
        "ports": [
          {
            "id": "reference",
            "name": "ref",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "measured",
            "name": "meas",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "error = reference - measured;\nwhen sample(0, samplePeriod) then\n  integral = max(-limit, min(limit, pre(integral) + samplePeriod*ki*error));\n  y = max(-limit, min(limit, kp*error + integral));\nend when;",
        "parameters": [
          {
            "id": "kp",
            "name": "Proportional gain",
            "value": 1,
            "unit": ""
          },
          {
            "id": "ki",
            "name": "Integral gain",
            "value": 2,
            "unit": ""
          },
          {
            "id": "limit",
            "name": "Output limit",
            "value": 10,
            "unit": "",
            "min": 0.001
          },
          {
            "id": "samplePeriod",
            "name": "Sample period",
            "value": 0.001,
            "unit": "s",
            "min": 0.0001
          }
        ],
        "declarations": "discrete Real integral(start=0, fixed=true);\nReal error;",
        "keywords": [
          "control",
          "regulator",
          "discrete",
          "sampled",
          "export",
          "c"
        ],
        "controller": true
      },
