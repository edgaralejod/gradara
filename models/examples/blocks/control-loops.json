    {
      "id": "pid",
      "definition": {
        "kind": "pid",
        "name": "PID",
        "symbol": "PID",
        "domain": "signal",
        "description": "Parallel PID with a filtered derivative term.",
        "ports": [
          {
            "id": "u",
            "name": "e",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "der(xi) = u;\nder(xf) = (u - xf)/tf;\ny = kp*u + ki*xi + kd*(u - xf)/tf;",
        "parameters": [
          {
            "id": "kp",
            "name": "Proportional gain",
            "value": 1,
            "unit": ""
          },
          {
            "id": "ki",
            "name": "Integral gain",
            "value": 2,
            "unit": ""
          },
          {
            "id": "kd",
            "name": "Derivative gain",
            "value": 0.05,
            "unit": ""
          },
          {
            "id": "tf",
            "name": "Derivative filter",
            "value": 0.01,
            "unit": "s",
            "min": 0.0001
          }
        ],
        "declarations": "Real xi(start=0, fixed=true);\nReal xf(start=0, fixed=true);",
        "keywords": [
          "control",
          "regulator"
        ],
        "controller": true
      },
