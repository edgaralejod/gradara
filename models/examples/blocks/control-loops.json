        ],
        "parameters": [
          {
            "id": "tau",
            "name": "Time constant",
            "value": 0.5,
            "unit": "s",
            "min": 0.00001
          }
        ],
        "declarations": "Real x(start=0, fixed=true);",
        "equations": "der(x) = (u-x)/tau;\ny = x;"
      },
      "position": {
        "x": 520,
