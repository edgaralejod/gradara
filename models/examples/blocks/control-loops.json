{
  "version": 1,
  "name": "Example: PI and PID loops",
  "exampleId": "block-control-loops",
  "description": "Each plant is a lag with τ = 0.5 s and each loop follows a unit step at 0.1 s. The PI and sampled PID blocks take the reference and the measurement and form the error themselves; the continuous PID takes the error from a subtract block. All three reach the set point with no steady error, because each has integral action. Change a gain and run again to compare.",
  "duration": 4,
  "revision": 0,
  "blocks": [
    {
      "id": "ref1",
      "definition": {
        "kind": "step",
        "name": "Set point (PI)",
        "description": "A step change from zero to a final value.",
        "domain": "signal",
        "symbol": "step",
        "ports": [
          {
            "id": "y",
            "name": "out",
            "direction": "output",
            "domain": "signal"
          }
        ],
        "parameters": [
          {
            "id": "height",
            "name": "Height",
            "value": 1,
            "unit": ""
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0.1,
            "unit": "s",
            "min": 0
          }
        ],
        "equations": "y = if time < startTime then 0 else height;",
        "keywords": [
          "source",
          "reference"
        ]
      },
      "position": {
        "x": 40,
        "y": 112
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "pi",
      "definition": {
        "kind": "pi",
        "name": "PI (sampled)",
        "description": "Sampled PI control with output saturation and a bounded integral state.",
        "domain": "signal",
        "symbol": "PI",
        "controller": true,
        "ports": [
          {
            "id": "reference",
            "name": "ref",
            "direction": "input",
            "domain": "signal"
          },
          {
            "id": "measured",
            "name": "meas",
            "direction": "input",
            "domain": "signal"
          },
          {
            "id": "y",
            "name": "out",
            "direction": "output",
            "domain": "signal"
          }
        ],
        "parameters": [
          {
            "id": "kp",
            "name": "Proportional gain",
            "value": 1,
            "unit": ""
          },
          {
            "id": "ki",
            "name": "Integral gain",
            "value": 2,
            "unit": ""
          },
          {
            "id": "limit",
            "name": "Voltage limit",
            "value": 10,
            "unit": "V",
            "min": 0.1
          },
          {
            "id": "samplePeriod",
            "name": "Sample period",
            "value": 0.001,
            "unit": "s",
            "min": 0.0001
          }
        ],
        "declarations": "discrete Real integral(start=0, fixed=true);\nReal error;",
        "equations": "error = reference - measured;\nwhen sample(0, samplePeriod) then\n  integral = max(-limit, min(limit, pre(integral) + samplePeriod*ki*error));\n  y = max(-limit, min(limit, kp*error + integral));\nend when;"
      },
      "position": {
        "x": 256,
        "y": 112
      },
      "size": {
        "width": 128,
        "height": 96
      }
    },
    {
