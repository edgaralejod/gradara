{
  "version": 1,
  "name": "Example: Three-phase loads",
  "exampleId": "block-three-phase-loads",
  "description": "The resistive load takes a 1 A peak current per phase and a constant 15 W in total: 3 · (10 V)² / (2 · 10 Ω). The R–L load has 10 Ω of resistance and 10 Ω of reactance, so its 0.71 A current lags the voltage by 45°. The delta bank puts each 100 µF capacitor between two lines, at 17.3 V peak, so each line carries √3 times the capacitor current. Phase taps pick single phases out of the plug for single-phase meters.",
  "duration": 0.1,
  "revision": 0,
  "blocks": [
    {
      "id": "s",
      "definition": {
        "kind": "threePhaseSource",
        "name": "10 V 50 Hz",
        "description": "Balanced three-phase sinusoidal voltages from plug − to plug +; a Star point on plug − gives the neutral.",
        "domain": "threePhase",
        "category": "threePhase",
        "symbol": "3~ AC",
        "ports": [
          {
            "id": "plug_p",
            "name": "abc",
            "direction": "physical",
            "domain": "threePhase",
            "side": "right"
          },
          {
            "id": "plug_n",
            "name": "abc−",
            "direction": "physical",
            "domain": "threePhase",
            "side": "bottom"
          }
        ],
        "parameters": [
          {
            "id": "V",
            "name": "Phase amplitude",
            "value": 10,
            "unit": "V"
          },
          {
            "id": "f",
            "name": "Frequency",
            "value": 50,
            "unit": "Hz",
            "min": 0
          }
        ],
        "equations": "// Electrical.Polyphase.Sources.SineVoltage from the Modelica Standard Library 4.1.0",
        "keywords": [
          "grid",
          "mains",
          "three phase"
        ],
        "modelica": {
          "class": "Modelica.Electrical.Polyphase.Sources.SineVoltage",
          "modifiers": {
            "V": "fill(V, 3)",
            "f": "fill(f, 3)"
          }
        }
      },
      "position": {
        "x": 104,
        "y": 128
      },
      "size": {
