{
  "version": 1,
  "name": "Example: Comparators",
  "exampleId": "block-comparators",
  "description": "The sine is sin(πt); the ramp is t/4. Above threshold is true while the sine exceeds 0.5, Below threshold while it is under −0.5. Greater and Less compare the sine with the ramp. Hysteresis turns on above 0.5 and off only below −0.5: at 1.05 s the sine is slightly negative, so Above threshold is already false but Hysteresis is still true.",
  "duration": 2,
  "revision": 0,
  "blocks": [
    {
      "id": "s",
      "definition": {
        "kind": "sine",
        "name": "sin(πt)",
        "symbol": "sine",
        "domain": "signal",
        "description": "A continuous sinusoid.",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = offset + amplitude*sin(6.283185307179586*frequency*time + phase);",
        "parameters": [
          {
            "id": "amplitude",
            "name": "Amplitude",
            "value": 1,
            "unit": ""
          },
          {
            "id": "frequency",
            "name": "Frequency",
            "value": 0.5,
            "unit": "Hz",
            "min": 0
          },
          {
            "id": "phase",
            "name": "Phase",
            "value": 0,
            "unit": "rad"
          },
          {
            "id": "offset",
            "name": "Offset",
            "value": 0,
            "unit": ""
          }
        ],
        "declarations": "",
        "keywords": [
          "source",
          "oscillator",
          "wave"
        ]
      },
      "position": {
        "x": 40,
        "y": 144
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
    {
      "id": "r",
      "definition": {
        "kind": "ramp",
        "name": "t / 4",
        "symbol": "ramp",
        "domain": "signal",
        "description": "A linearly increasing signal after a start time.",
        "ports": [
          {
            "id": "y",
            "name": "y",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": ""
          }
        ],
        "equations": "y = if time < startTime then 0 else slope*(time-startTime);",
        "parameters": [
          {
            "id": "slope",
            "name": "Slope",
            "value": 0.25,
            "unit": "1/s"
          },
          {
            "id": "startTime",
            "name": "Start time",
            "value": 0,
            "unit": "s",
            "min": 0
          }
        ],
        "declarations": "",
        "keywords": [
          "source",
          "reference"
        ]
      },
      "position": {
        "x": 40,
        "y": 432
      },
      "size": {
        "width": 80,
        "height": 64
      }
    },
