            "domain": "signal",
            "side": "left"
          },
          {
            "id": "va",
            "name": "a",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          },
          {
            "id": "vb",
            "name": "b",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          },
          {
            "id": "vc",
            "name": "c",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          }
        ],
        "equations": "offset = (max(ua,max(ub,uc))+min(ua,min(ub,uc)))/2;\nva = max(-Vdc/2,min(Vdc/2,ua-offset));\nvb = max(-Vdc/2,min(Vdc/2,ub-offset));\nvc = max(-Vdc/2,min(Vdc/2,uc-offset));",
        "parameters": [
          {
            "id": "Vdc",
            "name": "DC bus voltage",
            "value": 48,
            "unit": "V",
            "min": 1
          }
        ],
        "declarations": "Real offset;"
      },
