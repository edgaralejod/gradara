    {
      "id": "clarke",
      "definition": {
        "kind": "clarke",
        "name": "Clarke",
        "symbol": "abc→αβ",
        "domain": "signal",
        "description": "Amplitude-invariant three-phase to stationary-frame current transform.",
        "ports": [
          {
            "id": "ia",
            "name": "a",
            "direction": "input",
            "domain": "signal",
            "side": "right"
          },
          {
            "id": "ib",
