            "side": "bottom",
            "unit": "rad"
          },
          {
            "id": "wm",
            "name": "ω",
            "direction": "output",
            "domain": "signal",
            "side": "top",
            "unit": "rad/s"
          },
          {
            "id": "rpm",
            "name": "rpm",
            "direction": "output",
            "domain": "signal",
            "side": "top",
            "unit": "rpm"
          },
          {
            "id": "torque",
            "name": "Te",
            "direction": "output",
            "domain": "signal",
            "side": "top",
            "unit": "N·m"
          }
        ],
        "parameters": [
          {
            "id": "R",
            "name": "Stator resistance",
            "value": 0.35,
            "unit": "Ω",
            "min": 0.001
          },
          {
            "id": "Ld",
            "name": "d-axis inductance",
            "value": 0.001,
            "unit": "H",
            "min": 0.000001
          },
          {
            "id": "Lq",
            "name": "q-axis inductance",
            "value": 0.001,
            "unit": "H",
            "min": 0.000001
          },
          {
            "id": "psi",
            "name": "PM flux linkage",
            "value": 0.035,
            "unit": "Wb",
            "min": 0.0001
          },
          {
            "id": "polePairs",
            "name": "Pole pairs",
            "value": 4,
            "unit": "",
            "min": 1
          }
        ],
        "equations": "Ld*der(id) = vd - R*id + we*Lq*iq;\nLq*der(iq) = vq - R*iq - we*(Ld*id + psi);\ntorque = 1.5*polePairs*(psi*iq + (Ld-Lq)*id*iq);"
      },
