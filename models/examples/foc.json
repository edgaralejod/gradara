    {
      "id": "qPI",
      "definition": {
        "kind": "currentPI",
        "name": "q-axis PI",
        "symbol": "PI",
        "domain": "signal",
        "description": "Continuous PI current regulator with back-calculation anti-windup.",
        "ports": [
          {
            "id": "u",
            "name": "e",
            "direction": "input",
            "domain": "signal",
            "side": "left"
