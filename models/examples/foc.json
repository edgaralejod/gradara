      "definition": {
        "kind": "shaftLoad",
        "name": "Mechanical load",
        "symbol": "J",
        "domain": "mechanical",
        "description": "Shaft inertia, viscous friction and a step in opposing load torque at 0.45 s.",
        "ports": [
          {
            "id": "flange",
            "name": "shaft",
            "direction": "physical",
            "domain": "mechanical",
            "side": "left"
