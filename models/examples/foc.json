            "side": "right"
          },
          {
            "id": "ia",
            "name": "ia",
            "direction": "output",
            "domain": "signal",
            "side": "bottom",
            "unit": "A"
          },
          {
            "id": "ib",
            "name": "ib",
            "direction": "output",
            "domain": "signal",
            "side": "bottom",
            "unit": "A"
          },
          {
            "id": "ic",
            "name": "ic",
            "direction": "output",
            "domain": "signal",
            "side": "bottom",
            "unit": "A"
          },
          {
            "id": "theta",
            "name": "θe",
            "direction": "output",
