    {
      "id": "qPI",
      "definition": {
        "kind": "currentPI",
        "name": "q-axis PI",
        "symbol": "PI",
        "domain": "signal",
        "description": "Continuous PI current regulator with back-calculation anti-windup.",
        "ports": [
          {
            "id": "u",
            "name": "e",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "y",
            "name": "v",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          }
        ],
        "equations": "raw = kp*u + x;\ny = max(-limit, min(limit, raw));\nder(x) = ki*u + kaw*(y-raw);",
        "parameters": [
          {
            "id": "kp",
            "name": "Proportional gain",
            "value": 2,
            "unit": ""
          },
          {
            "id": "ki",
            "name": "Integral gain",
            "value": 700,
            "unit": ""
          },
          {
            "id": "kaw",
            "name": "Anti-windup gain",
            "value": 350,
            "unit": "1/s",
            "min": 0
          },
          {
            "id": "limit",
            "name": "Voltage limit",
            "value": 27,
            "unit": "V",
            "min": 0.1
          }
        ],
        "declarations": "Real x(start=0, fixed=true);\nReal raw;",
        "controller": true
      },
