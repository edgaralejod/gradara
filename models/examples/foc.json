    {
      "id": "inverter",
      "definition": {
        "kind": "inverter",
        "name": "Averaged inverter",
        "symbol": "inverter",
        "domain": "electrical",
        "description": "Averaged inverter with common-mode injection and DC-bus voltage clipping. No PWM switching ripple.",
        "ports": [
          {
            "id": "ua",
            "name": "a*",
            "direction": "input",
            "domain": "signal",
            "side": "left"
          },
          {
            "id": "ub",
