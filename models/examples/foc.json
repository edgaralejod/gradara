            "value": 0.05,
            "unit": "N·m"
          },
          {
            "id": "stepLoad",
            "name": "Added load torque",
            "value": 0.35,
            "unit": "N·m"
          },
          {
            "id": "loadTime",
            "name": "Load step time",
            "value": 0.45,
            "unit": "s",
            "min": 0
          }
        ],
        "equations": "loadTorque = initialLoad + (if time < loadTime then 0 else stepLoad);\nJ*der(w) = flange.tau - damping*w - loadTorque;"
