    {
      "id": "inverse",
      "definition": {
        "kind": "inversePark",
        "name": "Inverse Park / Clarke",
        "symbol": "dq→abc",
        "domain": "signal",
        "description": "Inverse Park and inverse Clarke transforms produce three phase-voltage commands.",
        "ports": [
          {
            "id": "vd",
            "name": "d",
            "direction": "input",
            "domain": "signal",
            "side": "left",
            "offset": 75
          },
          {
            "id": "vq",
            "name": "q",
            "direction": "input",
            "domain": "signal",
            "side": "left",
            "offset": 25
          },
          {
            "id": "theta",
            "name": "θe",
            "direction": "input",
            "domain": "signal",
            "side": "bottom"
          },
          {
            "id": "va",
            "name": "a",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          },
          {
            "id": "vb",
            "name": "b",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          },
          {
            "id": "vc",
            "name": "c",
            "direction": "output",
            "domain": "signal",
            "side": "right",
            "unit": "V"
          }
        ],
        "equations": "alpha = vd*cos(theta)-vq*sin(theta);\nbeta = vd*sin(theta)+vq*cos(theta);\nva = alpha;\nvb = -alpha/2 + sqrt(3)*beta/2;\nvc = -alpha/2 - sqrt(3)*beta/2;",
        "parameters": [],
        "declarations": "Real alpha;\nReal beta;"
      },
